{
  "name": "@cancakar/can-select",
  "version": "1.0.3",
  "license": "MIT",
  "type": "module",
  "description": "HTML searchable multi select",
  "keywords": [
    "select",
    "multiselect",
    "canselect",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cancakar35/can-select.git"
  },
  "author": {
    "name": "Can Çakar",
    "url": "https://github.com/cancakar35"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build": "vite build",
    "lint": "eslint .",
    "version": "node sync-nuspec-version.js && git add *.nuspec"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/can-select.umd.js",
  "module": "./dist/can-select.es.js",
  "types": "./dist/CanSelect.d.ts",
  "style": "./dist/can-select.css",
  "exports": {
    ".": {
      "import": "./dist/can-select.es.js",
      "require": "./dist/can-select.umd.js",
      "types": "./dist/CanSelect.d.ts"
    },
    "./package.json": "./package.json",
    "./can-select.css": "./dist/can-select.css"
  }
}
